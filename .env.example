# Copy this file to .env and fill in real values. Never commit .env.
# These are placeholders only.

# Supabase (Project Settings > API). Use the anon/public key, never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Not needed yet. Added in later build steps.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_key_here
EXPO_PUBLIC_ADMOB_APP_ID=your_admob_app_id_here
